BT 1 0 0 1 2 104.8 Tm /F3 7 Tf 8.6 TL (fig, ax = plt.subplots\(1, 4, figsize=\(16, 4\)\)) Tj T* (sns.boxplot\(y=d["age"], ax=ax[0], color="lightskyblue"\);  ax[0].set_title\("Age"\)) Tj T* (sns.boxplot\(y=d["fare"], ax=ax[1], color="salmon"\);       ax[1].set_title\("Fare"\)) Tj T* (sns.boxplot\(y=d["sibsp"], ax=ax[2], color="khaki"\);       ax[2].set_title\("Siblings/Spouses \(sibsp\)"\)) Tj T* (sns.boxplot\(y=d["parch"], ax=ax[3], color="plum"\);        ax[3].set_title\("Parents/Children \(parch\)"\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T*  T* (for c in ["age", "fare"]:) Tj T* (    q1, q2, q3 = d[c].quantile\([.25, .5, .75]\); iqr = q3 - q1) Tj T* (    lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr) Tj T* (    n_out = \(\(d[c] < lo\) | \(d[c] > hi\)\).sum\(\)) Tj T* (    print\(f"{c:5s}: Q1={q1:.2f}  median={q2:.2f}  Q3={q3:.2f}  IQR={iqr:.2f}  upper fence={hi:.2f}  ) Tj T* (outliers={n_out}"\)) Tj T* ET

BT 1 0 0 1 2 216.6 Tm /F3 7 Tf 8.6 TL (q1, q3 = d["fare"].quantile\([.25, .75]\); fence = q3 + 1.5*\(q3 - q1\)) Tj T* (print\("Fare IQR upper fence: %.2f | passengers above fence: %d" % \(fence, \(d.fare > fence\).sum\(\)\)\)) Tj T* (print\("\\nTop 6 fares:"\)) Tj T* (print\(d.nlargest\(6, "fare"\)[["fare", "pclass", "sex", "age", "survived", "embark_town"]].to_string\(\)\)) Tj T* (print\("\\nPassengers with fare = 0: %d \(survival rate %.2f\)" % \(\(d.fare == 0\).sum\(\), d[d.fare == ) Tj T* (0].survived.mean\(\)\)\)) Tj T* (print\(d[d.fare == 0][["pclass", "sex", "age", "survived"]].pclass.value_counts\(\).to_dict\(\)\)) Tj T* (print\("\\nOldest passengers \(age >= 65\):"\)) Tj T* (print\(d[d.age >= 65][["age", "sex", "pclass", "survived"]].sort_values\("age"\).to_string\(\)\)) Tj T* (print\("\\nInfants \(age < 1\):"\)) Tj T* (print\(d[d.age < 1][["age", "sex", "pclass", "survived"]].to_string\(\)\)) Tj T* (print\("\\nLargest families:"\)) Tj T* (print\(d.nlargest\(5, "family_size"\)[["family_size", "pclass", "sex", "age", "survived"]].to_string\(\)\)) Tj T*  T* (fig, ax = plt.subplots\(1, 2, figsize=\(14, 4.5\)\)) Tj T* (sns.stripplot\(data=d, x="pclass", y="fare", hue="alive", hue_order=["no", "yes"], palette=["#d9534f", ) Tj T* ("#5cb85c"],) Tj T* (              alpha=.6, jitter=.25, ax=ax[0]\)) Tj T* (ax[0].axhline\(fence, color="k", ls="--", lw=1, label="IQR fence"\); ax[0].set_title\("Fare by class - ) Tj T* (outliers highlighted"\); ax[0].legend\(\)) Tj T* (sns.lineplot\(data=d.assign\(age_bin=\(d.age // 5 * 5\)\).dropna\(subset=["age_bin"]\), x="age_bin", ) Tj T* (y="survived",) Tj T* (             hue="sex", marker="o", palette={"male": "#1f77b4", "female": "#e377c2"}, errorbar=None, ) Tj T* (ax=ax[1]\)) Tj T* (ax[1].set_title\("Trend: survival rate across age \(5-year bins\)"\); ax[1].set_xlabel\("age \(bin start\)"\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T* ET

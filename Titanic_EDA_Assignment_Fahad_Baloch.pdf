BT 1 0 0 1 2 147.8 Tm /F3 7 Tf 8.6 TL (num_cols = ["survived", "pclass", "age", "sibsp", "parch", "fare", "family_size"]) Tj T* (corr = d[num_cols].corr\(\)) Tj T* (plt.figure\(figsize=\(8, 6.5\)\)) Tj T* (mask = np.triu\(np.ones_like\(corr, dtype=bool\)\)) Tj T* (sns.heatmap\(corr, annot=True, fmt=".2f", cmap="coolwarm", center=0, vmin=-1, vmax=1,) Tj T* (            mask=mask, linewidths=.5, cbar_kws={"label": "Pearson r"}\)) Tj T* (plt.title\("Correlation heatmap \(numerical variables\)"\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T*  T* (pairs = \(corr.where\(~mask\).stack\(\).rename\("r"\).reset_index\(\)) Tj T* (            .query\("level_0 != level_1"\)\)) Tj T* (pairs.columns = ["var1", "var2", "r"]) Tj T* (pairs["abs_r"] = pairs["r"].abs\(\)) Tj T* (print\("Top pairs by absolute correlation:"\)) Tj T* (print\(pairs.sort_values\("abs_r", ) Tj T* (ascending=False\).head\(8\).drop\(columns="abs_r"\).round\(2\).to_string\(index=False\)\)) Tj T* (print\("\\nCorrelation with target \(survived\):"\)) Tj T* (print\(corr["survived"].drop\("survived"\).sort_values\(\).round\(2\)\)) Tj T* ET
Q
 


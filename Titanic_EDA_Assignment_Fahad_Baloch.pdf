BT 1 0 0 1 2 96.2 Tm /F3 7 Tf 8.6 TL (fig, ax = plt.subplots\(1, 2, figsize=\(14, 4.5\)\)) Tj T* (age_surv = d.groupby\("age_group"\)["survived"].agg\(["mean", "count"]\)) Tj T* (sns.barplot\(x=age_surv.index, y=age_surv["mean"], ax=ax[0], palette="rocket"\)) Tj T* (ax[0].set_title\("Survival rate by age group"\); ax[0].set_ylim\(0, 1\); ax[0].tick_params\(axis="x", ) Tj T* (rotation=20\)) Tj T* (for i, \(m, n\) in enumerate\(zip\(age_surv["mean"], age_surv["count"]\)\):) Tj T* (    ax[0].text\(i, m + 0.02, f"{m:.2f}\\n\(n={n}\)", ha="center", fontsize=8\)) Tj T* (fs = pd.crosstab\(d["family_size"], d["alive"], normalize="index"\)[["no", "yes"]]*100) Tj T* (fs.plot\(kind="bar", stacked=True, ax=ax[1], color=["#d9534f", "#5cb85c"], rot=0\)) Tj T* (ax[1].set_title\("Stacked bar: outcome share \(%\) by family size"\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T* (print\(age_surv.round\(3\)\)) Tj T* ET

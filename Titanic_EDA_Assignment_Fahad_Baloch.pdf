BT 1 0 0 1 2 104.8 Tm /F3 7 Tf 8.6 TL (fig, ax = plt.subplots\(1, 3, figsize=\(16, 4.2\)\)) Tj T* (sns.heatmap\(d[["age", "deck", "embarked"]].isna\(\), cbar=False, yticklabels=False, cmap="viridis", ) Tj T* (ax=ax[0]\)) Tj T* (ax[0].set_title\("Missing-value map \(yellow = missing\)"\)) Tj T* (sns.barplot\(data=d, x="has_cabin_info", y="survived", ax=ax[1], palette="crest", errorbar=None\)) Tj T* (ax[1].set_title\("Survival rate: cabin info recorded?"\); ax[1].set_ylim\(0, 1\)) Tj T* (sns.countplot\(data=d, x="pclass", hue="age_missing", ax=ax[2], palette="Set1"\)) Tj T* (ax[2].set_title\("Passengers with missing age, by class"\)) Tj T* (plt.tight_layout\(\); plt.show\(\)) Tj T* (print\(d.groupby\("has_cabin_info"\)["survived"].agg\(["mean", "count"]\).round\(3\)\)) Tj T* (print\(d.groupby\("age_missing"\)["survived"].agg\(["mean", "count"]\).round\(3\)\)) Tj T* (print\("Share of missing-age passengers by class:", ) Tj T* (d[d.age_missing]["pclass"].value_counts\(normalize=True\).round\(3\).to_dict\(\)\)) Tj T* ET
